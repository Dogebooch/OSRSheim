{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/scripts/doc-guard.py\"",
            "timeout": 10,
            "statusMessage": "Doc size guard"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/scripts/collection-guard.py\"",
            "timeout": 30,
            "statusMessage": "Collection log guard"
          }
        ]
      }
    ]
  }
}