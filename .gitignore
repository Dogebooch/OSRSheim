# Timestamped backups - git is the history now
*.bak
*.bak-*
*.bak.*
*.cllc-example

# Mod-shipped examples and runtime output
*.log
*.log.*
__pycache__/
*.pyc

# Local-only Claude settings
.claude/settings.local.json

# KG binary assets - Gale reinstalls these with the mod
config/Marketplace_CachedImages/
config/Marketplace_KGChat_Emojis/
config/Marketplace_Models/
config/Marketplace_Sounds/
config/Marketplace_VideoClips/

# WackysDatabase output - Cache is rebuilt every launch, BulkYML by wackydb_all_items
config/wackysDatabase/Cache/
config/wackyDatabase-BulkYML/*
!config/wackyDatabase-BulkYML/.gitkeep

# Live state - the host's bank and bounty ledgers; a deploy must never overwrite them
config/Marketplace/SavedData/
config/EpicLoot/BountySaves/

# Never commit credentials
*.env
secrets.*

# extract-game-data.py bundle index (rebuilt from the game install)
.cache/

# Test-only frame-time capture (#66): PresentMon.exe + captures
perf/

# scripts/sim-run.py output
sim-out/
